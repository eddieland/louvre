# serializer version: 1
# name: test_a_chart_is_drawn_as_it_was[bar]
  '''
  <figure class="l-plot">
  <figcaption><span class="l-say">Redis makes a sixteenth of the tax calls of no cache at all</span>
  <span class="l-measure">Tax calls a week, replaying 22 October</span></figcaption>
  <svg class="l-chart" viewBox="0 0 440 106" role="img">
  <title>Redis makes a sixteenth of the tax calls of no cache at all. Tax calls a week, replaying 22
      October</title>
  <text class="l-name" x="0" y="21" fill="var(--l-muted)">In process</text>
  <rect x="88" y="10" width="113.50" height="14" fill="var(--l-muted)" opacity="0.6"/>
  <text x="207.5" y="21" text-anchor="start">1.2M</text>
  <text class="l-name" x="0" y="55" fill="var(--l-ink)">Redis</text>
  <rect x="88" y="44" width="17.97" height="14" fill="var(--l-accent)" opacity="1"/>
  <text x="111.97" y="55" text-anchor="start" class="l-value" fill="var(--l-accent)">190k</text>
  <text class="l-mark" x="147.97" y="48">1</text>
  <text class="l-name" x="0" y="89" fill="var(--l-muted)">No cache</text>
  <rect x="88" y="78" width="293.20" height="14" fill="var(--l-muted)" opacity="0.6"/>
  <text x="387.2" y="89" text-anchor="start">3.1M</text>
  </svg>
  <ol class="l-notes">
  <li>Recommended: one small node.</li>
  </ol>
  </figure>
  
  '''
# ---
# name: test_a_chart_is_drawn_as_it_was[dot]
  '''
  <figure class="l-plot">
  <figcaption><span class="l-say">Abandonment fell in every region but sa-east</span>
  <span class="l-measure">Abandoned at payment, by region, week 42 to week 43</span></figcaption>
  <svg class="l-chart" viewBox="0 0 440 190" role="img">
  <title>Abandonment fell in every region but sa-east. Abandoned at payment, by region, week 42 to week 43</title>
  <line x1="81.6" x2="81.6" y1="22" y2="164" stroke="var(--l-rule)"/>
  <text x="81.6" y="182" text-anchor="middle">6</text>
  <line x1="194.4" x2="194.4" y1="22" y2="164" stroke="var(--l-rule)"/>
  <text x="194.4" y="182" text-anchor="middle">8</text>
  <line x1="307.2" x2="307.2" y1="22" y2="164" stroke="var(--l-rule)"/>
  <text x="307.2" y="182" text-anchor="middle">10</text>
  <line x1="420" x2="420" y1="22" y2="164" stroke="var(--l-rule)"/>
  <text x="420" y="182" text-anchor="middle">12%</text>
  <text class="l-name" x="0" y="50" fill="var(--l-ink)">us-east</text>
  <line x1="188.76" x2="312.84" y1="45" y2="45" stroke="var(--l-muted)" stroke-width="1.5"/>
  <circle cx="312.84" cy="45" r="4" fill="var(--l-bg)" stroke-width="1.5" stroke="var(--l-muted)"/>
  <circle cx="188.76" cy="45" r="4.5" fill="var(--l-accent)"/>
  <text class="l-name" x="0" y="84" fill="var(--l-ink)">eu-west</text>
  <line x1="239.52" x2="397.44" y1="79" y2="79" stroke="var(--l-muted)" stroke-width="1.5"/>
  <circle cx="397.44" cy="79" r="4" fill="var(--l-bg)" stroke-width="1.5" stroke="var(--l-muted)"/>
  <circle cx="239.52" cy="79" r="4.5" fill="var(--l-accent)"/>
  <text class="l-name" x="0" y="118" fill="var(--l-ink)">ap-south</text>
  <line x1="216.96" x2="301.56" y1="113" y2="113" stroke="var(--l-muted)" stroke-width="1.5"/>
  <circle cx="301.56" cy="113" r="4" fill="var(--l-bg)" stroke-width="1.5" stroke="var(--l-muted)"/>
  <circle cx="216.96" cy="113" r="4.5" fill="var(--l-accent)"/>
  <text class="l-name" x="0" y="152" fill="var(--l-ink)">sa-east</text>
  <line x1="149.28" x2="177.48" y1="147" y2="147" stroke="var(--l-muted)" stroke-width="1.5"/>
  <circle cx="149.28" cy="147" r="4" fill="var(--l-bg)" stroke-width="1.5" stroke="var(--l-muted)"/>
  <circle cx="177.48" cy="147" r="4.5" fill="var(--l-accent)"/>
  <text class="l-mark" x="185.48" y="141">1</text>
  <text class="l-label" x="188.76" y="16" text-anchor="middle" fill="var(--l-accent)">week 43</text>
  <text class="l-label" x="312.84" y="16" text-anchor="middle" fill="var(--l-muted)">week 42</text>
  </svg>
  <ol class="l-notes">
  <li>Its fraud check moved a week later.</li>
  </ol>
  </figure>
  
  '''
# ---
# name: test_a_chart_is_drawn_as_it_was[line]
  '''
  <figure class="l-plot">
  <figcaption><span class="l-say">Checkout fell under its target on Thursday, and stayed there</span>
  <span class="l-measure">p95 checkout, by day of week 43, against week 42</span></figcaption>
  <svg class="l-chart" viewBox="0 0 440 196" role="img">
  <title>Checkout fell under its target on Thursday, and stayed there. p95 checkout, by day of week 43, against
      week 42</title>
  <line x1="0" x2="361.2" y1="168" y2="168" stroke="var(--l-rule)"/>
  <text x="0" y="163">0</text>
  <line x1="0" x2="361.2" y1="120" y2="120" stroke="var(--l-rule)"/>
  <text x="0" y="115">500</text>
  <line x1="0" x2="361.2" y1="72" y2="72" stroke="var(--l-rule)"/>
  <text x="0" y="67">1,000</text>
  <line x1="0" x2="361.2" y1="24" y2="24" stroke="var(--l-rule)"/>
  <text x="0" y="19">1,500 ms</text>
  <line x1="0" x2="361.2" y1="124.8" y2="124.8" stroke="var(--l-muted)" stroke-dasharray="1 3"/>
  <polyline fill="none" stroke="var(--l-muted)" stroke-width="1.25" stroke-linejoin="round" stroke-linecap="round"
      points="46,124.8 97.2,122.88 148.4,125.76 199.6,123.84 250.8,124.32 302,124.8 353.2,125.28"/>
  <polyline fill="none" stroke="var(--l-accent)" stroke-width="2.25" stroke-linejoin="round"
      stroke-linecap="round" points="46,54.72 97.2,60.48 148.4,98.88 199.6,122.88 250.8,125.76 302,126.24
      353.2,126.72"/>
  <circle cx="353.2" cy="126.72" r="3.5" fill="var(--l-accent)"/>
  <text class="l-value" x="353.2" y="117.72" text-anchor="end" fill="var(--l-accent)">430 ms</text>
  <circle cx="97.2" cy="60.48" r="3" fill="var(--l-bg)" stroke-width="1.5" stroke="var(--l-accent)"/>
  <text class="l-mark" x="103.2" y="53.48">1</text>
  <circle cx="199.6" cy="122.88" r="3" fill="var(--l-bg)" stroke-width="1.5" stroke="var(--l-accent)"/>
  <text class="l-mark" x="205.6" y="115.88">2</text>
  <text class="l-label" x="371.2" y="128.8" fill="var(--l-muted)">target</text>
  <text class="l-label" x="371.2" y="143.8" fill="var(--l-muted)">last week</text>
  <text class="l-label" x="371.2" y="158.8" fill="var(--l-accent)">this week</text>
  <text x="46" y="190" text-anchor="start">Mon</text>
  <text x="97.2" y="190" text-anchor="middle">Tue</text>
  <text x="148.4" y="190" text-anchor="middle">Wed</text>
  <text x="199.6" y="190" text-anchor="middle">Thu</text>
  <text x="250.8" y="190" text-anchor="middle">Fri</text>
  <text x="302" y="190" text-anchor="middle">Sat</text>
  <text x="353.2" y="190" text-anchor="end">Sun</text>
  </svg>
  <ol class="l-notes">
  <li>The tax fix ships.</li>
  <li>Under the target for the first time since September.</li>
  </ol>
  <p class="l-source">Checkout events, 19 to 25 October 2026</p>
  </figure>
  
  '''
# ---
