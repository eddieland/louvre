{
  "name": "louvre-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "cd .. && uv run louvre serve --port 8765",
    "build": "vite build && vite build -c vite.bridge.config.ts",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc -b",
    "lint": "oxlint --type-aware --deny-warnings && node scripts/check-source.mjs",
    "test": "vitest run",
    "check": "npm run fmt:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-router": "1.170.44",
    "clsx": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.46",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint-plugin-jsdoc": "65.3.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "happy-dom": "21.0.3",
    "oxc-transform-react": "0.152.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
